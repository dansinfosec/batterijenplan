# Base URL of the deployed Django backend, WITHOUT /api and WITHOUT trailing slash.
# Leave empty (or omit the file) in local dev: the Vite proxy forwards /api to http://localhost:8000.
VITE_API_BASE_URL=https://api.batterijenplan.nl

# Google Tag Manager is the single source of truth for GA4 + Google Ads.
# The container ID (GTM-M99LXDK2) is hardcoded in index.html, so no env var is
# needed. Configure the GA4/Google Ads tags inside GTM.
# NOTE: VITE_GA_MEASUREMENT_ID is no longer used by the frontend; put that GA4
# Measurement ID in GTM's GA4 Configuration tag instead.
