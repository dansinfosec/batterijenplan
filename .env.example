# Django backend environment variables
# Copy to .env for local overrides, or set these in your hosting dashboard (Render/Railway/VPS).

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Must be False in production
DEBUG=False

# Comma-separated hostnames (no scheme, no trailing slash)
ALLOWED_HOSTS=your-backend.onrender.com,api.batterijenplan.nl

# PostgreSQL connection string. Leave unset locally to fall back to SQLite.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Comma-separated origins WITH scheme (the deployed frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://batterijenplan.nl

# Comma-separated origins WITH scheme (backend + frontend domains that submit forms/admin logins)
CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com,https://your-frontend.vercel.app
